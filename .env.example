########################################################################
#  QUANTUM DISTRICT — LOCAL ENVIRONMENT
#  Copy of .env.example with your real values. NEVER commit this file.
########################################################################


# ─────────────────────────────────────────────────────────────────────
#  1. SITE
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@quantumdistrict.com
NEXT_PUBLIC_CONTACT_PHONE=+1 (202) 555-0147


# ─────────────────────────────────────────────────────────────────────
#  2. EMAIL — Nodemailer over Gmail SMTP
# ─────────────────────────────────────────────────────────────────────
#  HOW TO GET AN APP PASSWORD (required — your normal Gmail password
#  will NOT work):
#
#    1. Go to  https://myaccount.google.com/security
#    2. Turn ON 2-Step Verification for the account.
#    3. Go to  https://myaccount.google.com/apppasswords
#    4. App name: "Quantum District Website"  →  Create
#    5. Google shows a 16-character password like: abcd efgh ijkl mnop
#    6. Paste it below. Spaces are fine — they are stripped by Gmail,
#       but removing them yourself is safest.
#
#  Google Workspace users: an admin may need to allow app passwords
#  under Security → Less secure / App passwords.
#
#  Gmail sending limits: ~500 messages/day (free) or 2,000/day
#  (Workspace). For higher volume, swap SMTP_HOST for a transactional
#  provider — no code changes needed.
# ─────────────────────────────────────────────────────────────────────

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where inquiry notifications are delivered (defaults to GMAIL_USER)
MAIL_TO=

# The From: header shown to recipients
MAIL_FROM=Quantum District <you@gmail.com>

# Send the branded confirmation email back to the person who wrote in
SEND_AUTOREPLY=true

# SMTP transport (Gmail defaults — only change for another provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
#  Port 465 → SMTP_SECURE=true   (implicit TLS, recommended)
#  Port 587 → SMTP_SECURE=false  (STARTTLS)


# ─────────────────────────────────────────────────────────────────────
#  3. AI ASSISTANT  (optional)
# ─────────────────────────────────────────────────────────────────────
#  With a key, the floating assistant answers with Claude, grounded in
#  src/data/knowledge.ts. Without a key it automatically falls back to
#  curated knowledge-base answers plus an email handoff — the site works
#  either way.
#
#  Get a key: https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5


# ─────────────────────────────────────────────────────────────────────
#  4. PARTNERSHIP / CONTRACT PLATFORM
# ─────────────────────────────────────────────────────────────────────
#  Choose which client portal powers proposals, agreements and
#  e-signature:  dubsado  |  honeybook  |  none
#
#  Set it and the /start page, the partnership section, and the copy
#  throughout the site all follow automatically.
# ─────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_PARTNER_PLATFORM=none

# --- Dubsado -----------------------------------------------------------
#  Form URL:      Dubsado → Forms → your Lead Capture form → Share →
#                 "Direct link" (https://www.dubsado.com/public/form/...)
#  Scheduler URL: Dubsado → Scheduler → Share link
#  Proposal URL:  Dubsado → Templates → Proposal → public/share link
NEXT_PUBLIC_DUBSADO_FORM_URL=
NEXT_PUBLIC_DUBSADO_SCHEDULER_URL=
NEXT_PUBLIC_DUBSADO_PROPOSAL_URL=

# --- HoneyBook ---------------------------------------------------------
#  Form URL:       HoneyBook → Tools → Contact Form → Share → copy link
#  Session URL:    HoneyBook → Scheduler → session share link
#  Smart file URL: HoneyBook → Templates → Proposal/Contract → public link
NEXT_PUBLIC_HONEYBOOK_FORM_URL=
NEXT_PUBLIC_HONEYBOOK_SCHEDULER_URL=
NEXT_PUBLIC_HONEYBOOK_SMART_FILE_URL=
